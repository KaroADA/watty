<workout_file>
    <name>Sweet Spot 3x10</name>
    <description>3 x 10 min @ 90% FTP, 5 min recovery. ~67 min.</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.50" PowerHigh="0.75"/>
        <SteadyState Duration="60" Power="0.95"/>
        <SteadyState Duration="240" Power="0.55"/>
        <IntervalsT Repeat="3" OnDuration="600" OffDuration="300" OnPower="0.90" OffPower="0.55"/>
        <Cooldown Duration="420" PowerLow="0.60" PowerHigh="0.40"/>
    </workout>
</workout_file>
